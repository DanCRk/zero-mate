{
  "name": "zero-mate",
  "version": "0.3.1-alpha.1",
  "description": "ZeroMate — Multi-Theme Desktop Agent Engine with Semantic Action Slots, 2D WebGL Rigging, Window Tracking and Headless Multi-Brain Routing.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "sounds": "node tools/generate-nier-sounds.js",
    "assets": "node tools/prepare-assets.js",
    "build:launcher": "node tools/build-launcher.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:install:agy": "node scripts/install-hooks-agy.js",
    "hooks:uninstall:agy": "node scripts/install-hooks-agy.js --uninstall"
  },
  "keywords": [
    "zeromate",
    "desktop-agent",
    "multi-theme",
    "electron",
    "ai-assistant"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^3.8.1"
  },
  "build": {
    "appId": "com.dancrk.zeromate",
    "productName": "ZeroMate",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "themes/**/*",
      "hooks/**/*",
      "scripts/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "themes/nier-2b/assets/yorha.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZeroMate",
      "artifactName": "ZeroMate-Setup-${version}.${ext}"
    }
  }
}
